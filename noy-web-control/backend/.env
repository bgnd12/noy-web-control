# Konfigurasi Web Control — TIDAK berisi secret/API key (semua secret milik
# noy-agent/.env dan hanya dibaca oleh proses Noy itu sendiri).

# Host & port Web Control (bukan port Noy)
NOY_WEB_HOST=127.0.0.1
NOY_WEB_PORT=8787

# Lokasi Noy Agent ASLI
NOY_AGENT_DIR=C:\Users\akbar\Noy Agent

# Command persis yang biasa diketik manual
NOY_AGENT_CMD=py -3.12 main.py

# Biner Python 3.12 Noy (resolve dari `py -3.12`). Boleh dihapus baris ini:
# kalau dikosongkan, path di-resolve otomatis pada saat START.
NOY_AGENT_PYTHON=C:\Users\akbar\AppData\Local\Programs\Python\Python312\python.exe

# Opsional: tuning waktu (detik)
NOY_STARTING_GRACE_SECONDS=5
NOY_STOP_GRACE_SECONDS=6
NOY_LOG_BUFFER_SIZE=200
# Salin file ini menjadi ".env" di folder backend/ yang sama, lalu sesuaikan nilainya.

# Host & port Web Control (bukan port Noy — Noy tidak buka port apa pun)
NOY_WEB_HOST=127.0.0.1
NOY_WEB_PORT=8787

# WAJIB disesuaikan: path folder tempat main.py Noy Agent berada
NOY_AGENT_DIR=C:\Users\NamaAnda\Projects\NOY\noy-agent

# Command persis yang biasa Anda ketik manual di terminal
NOY_AGENT_CMD=py -3.12 main.py

# Opsional: tuning waktu (detik)
NOY_STARTING_GRACE_SECONDS=5
NOY_STOP_GRACE_SECONDS=6
NOY_LOG_BUFFER_SIZE=200
